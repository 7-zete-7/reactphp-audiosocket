root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.json]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.neon]
indent_style = tab

[composer.json]
indent_size = 4

[infection{,.dist}.json5]
indent_size = 4

[Dockerfile]
indent_style = tab

[compose{,.*}.yaml]
indent_size = 2
